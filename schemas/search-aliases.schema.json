{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brimstockh.github.io/dnd5e-quickref-2024/schemas/search-aliases.schema.json",
  "title": "Alias éditoriaux de recherche D&D 2024",
  "type": "object",
  "required": ["schemaVersion", "aliases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "aliases": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": false
}
