{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brimstockh.github.io/dnd5e-quickref-2024/schemas/local-storage-contracts.schema.json",
  "title": "Registre des stockages locaux",
  "type": "object",
  "required": ["schemaVersion", "contracts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "owner", "currentVersion", "backupBeforeMigration", "contains"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "currentVersion": {"type": "integer", "minimum": 1},
          "backupBeforeMigration": {"type": "boolean"},
          "contains": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
