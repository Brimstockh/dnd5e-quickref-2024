{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brimstockh.github.io/dnd5e-quickref-2024/schemas/search-index.schema.json",
  "title": "Index de recherche D&D 2024",
  "type": "object",
  "required": ["schemaVersion", "version", "count", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "const": 4 },
    "count": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "category", "url", "aliases", "keywords", "excerpt"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
          },
          "type": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "excerpt": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
