{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brimstockh.github.io/dnd5e-quickref-2024/schemas/lore.schema.json",
  "title": "Lore multiversel D&D 2024",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "aliases", "category", "setting", "summary", "details", "related", "target", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^lore-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "category": { "enum": ["person", "deity", "group", "place", "material", "event", "concept"] },
          "setting": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "summary": { "type": "string", "minLength": 1 },
          "details": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "related": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^lore-[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "target": { "type": ["string", "null"], "pattern": "^(?:[^:#?]+(?:\\?[^#]*)?)(?:#[-a-z0-9]+)?$" },
          "source": {
            "type": "object",
            "required": ["book", "section"],
            "properties": {
              "book": { "type": "string", "minLength": 1 },
              "section": { "type": "string", "minLength": 1 },
              "pages": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
