{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brimstockh.github.io/dnd5e-quickref-2024/schemas/content-relations.schema.json",
  "title": "Index des relations entre contenus D&D 2024",
  "type": "object",
  "required": ["schemaVersion", "count", "targets", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "targets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "url", "category"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "url", "relations"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "type"],
              "properties": {
                "target": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$"
                },
                "type": {
                  "enum": ["available-for", "prerequisite", "related-rule", "see-also"]
                },
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "order": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
