{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dnd5e-quickref.local/schemas/magic-items.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 2 },
    "ruleset": { "const": "2024" },
    "sourceRef": { "type": "string", "minLength": 1 },
    "localization": {
      "type": "object",
      "required": ["interfaceLanguage", "contentLanguage", "originalDescriptionField"],
      "properties": {
        "interfaceLanguage": { "const": "fr" },
        "contentLanguage": { "type": "string", "minLength": 2 },
        "translatedDescriptionField": { "type": ["string", "null"] },
        "originalDescriptionField": { "const": "description" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "officialName", "type", "rarity", "description", "sourceRef", "sourcePage", "verificationStatus"],
        "properties": {
          "id": { "type": "string", "pattern": "^magic-item-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "officialName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "verificationStatus": { "enum": ["raw-transcription", "cleaned", "verified", "needs-verification"] },
          "sourceRef": { "type": "string", "minLength": 1 },
          "sourcePage": { "type": "integer", "minimum": 227, "maximum": 325 },
          "requiresAttunement": { "type": "boolean" },
          "attunement": {
            "type": "object",
            "required": ["required"],
            "properties": { "required": { "type": "boolean" } }
          },
          "tables": { "type": "array" },
          "variants": { "type": "array" }
        }
      }
    }
  },
  "required": ["schemaVersion", "ruleset", "sourceRef", "localization", "items"]
}
